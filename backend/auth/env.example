NODE_ENV=development
PORT=3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=smart_medicine
MYSQL_PASSWORD=change_this_database_password
MYSQL_DATABASE=smart_medicine_demo
MYSQL_POOL_SIZE=10
# Optional; production maintenance should use a separate privileged account.
MYSQL_MAINTENANCE_USER=
MYSQL_MAINTENANCE_PASSWORD=

# Generate a unique random secret; never use this example value in a real deployment.
JWT_SECRET=replace_this_with_a_unique_random_secret_at_least_32_chars_long
JWT_ISSUER=smart-medicine-api
JWT_AUDIENCE=smart-medicine-client
JWT_ACCESS_EXPIRES_IN=15m

BCRYPT_SALT_ROUNDS=12
BCRYPT_MAX_CONCURRENT=2
BCRYPT_MAX_QUEUE=50
# Align UV_THREADPOOL_SIZE with available CPU and other libuv users.
UV_THREADPOOL_SIZE=4
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set only behind a trusted reverse proxy. Use false, hop count, loopback or explicit CIDRs; never true.
TRUST_PROXY=false

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_IP_MAX=30
AUTH_RATE_LIMIT_IDENTITY_MAX=10
AUTH_RATE_LIMIT_FAILURE_WINDOW_SECONDS=900
# Identity-wide temporary blocks need multiple independent source IPs; pair/IP limiters apply separately.
AUTH_RATE_LIMIT_GLOBAL_BLOCK_MIN_FAILURES=30
AUTH_RATE_LIMIT_GLOBAL_BLOCK_MIN_IPS=5
AUTH_RATE_LIMIT_GLOBAL_BLOCK_SECOND_LEVEL_FAILURES=60
AUTH_RATE_LIMIT_GLOBAL_BLOCK_SECOND_LEVEL_IPS=10
AUTH_RATE_LIMIT_GLOBAL_BLOCK_THIRD_LEVEL_FAILURES=100
AUTH_RATE_LIMIT_GLOBAL_BLOCK_THIRD_LEVEL_IPS=20
REDIS_CONNECT_TIMEOUT_MS=10000
# Required (>=32 chars, independently generated) when Redis is configured.
AUTH_RATE_LIMIT_HMAC_SECRET=

# Required in production unless the explicit single-instance override is enabled.
# If set, Redis is a required dependency; startup fails when Redis is unavailable.
REDIS_URL=
ALLOW_IN_MEMORY_RATE_LIMIT_IN_PRODUCTION=false
# Emergency only: exactly one replica, approval ticket, expiry no more than 24h in future.
DEPLOYMENT_REPLICAS=1
RATE_LIMIT_MEMORY_EMERGENCY_APPROVAL=
RATE_LIMIT_MEMORY_EMERGENCY_EXPIRES_AT=
# RFC1123 GMT, populated after Product approves alias retirement date.
LEGACY_API_SUNSET=
LOG_LEVEL=info
ADMIN_EMAIL=

# Set true only after migrations 005+006, runtime role refresh_sessions privileges, and MongoDB replica set tests.
REFRESH_TOKENS_ENABLED=false
# Email verification via Resend; leave unset in dev to disable delivery (503).
MAIL_API_KEY=
MAIL_FROM=
PUBLIC_APP_URL=http://localhost:5173
# 32 random bytes as 64 hexadecimal digits; REQUIRED IN PRODUCTION for mandatory ADMIN MFA.
MFA_ENCRYPTION_KEY=

# Independent AES-256-GCM key (64 hex chars) for durable email outbox jobs.
MAIL_OUTBOX_ENCRYPTION_KEY=

# Optional staged key rotation: JSON map of keyId to 64-hex key, active ID.
# Keep MFA_ENCRYPTION_KEY for decrypting legacy ciphertext during the rollout.
# MFA_ENCRYPTION_KEYS={"2026b":"<64 hex characters>"}
MFA_ACTIVE_KEY_ID=

# Staged outbox rotation (R03): new writes v2 with active ID; keep legacy key
# until ALL v1 jobs have been processed/rewrapped. Never remove a retired key
# before running `npm run outbox:keys:check` on production.
# MAIL_OUTBOX_ENCRYPTION_KEYS={"2026b":"<64 hex characters>"}
MAIL_OUTBOX_ACTIVE_KEY_ID=
