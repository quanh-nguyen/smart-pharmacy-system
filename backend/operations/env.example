PORT=3000

# MySQL 8 hoặc MariaDB 10.5+ (XAMPP cũng được)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pharmacy
DB_USER=root
DB_PASSWORD=
# true để in câu SQL ra console khi debug
DB_LOGGING=false

# Phải trùng với secret mà module Auth của nhóm dùng để ký JWT
JWT_SECRET=change-me
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
# Ngôn ngữ OCR của Tesseract
OCR_LANG=vie+eng
MAX_UPLOAD_MB=10
