# Copy to .env locally; NEVER commit .env to GitHub
# IMPORTANT: use a BRAND-NEW MySQL database for the demo (never production).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=medibridge_demo_user
DB_PASSWORD=replace_with_demo_only_password
DB_NAME=medibridge_demo
# For managed external MySQL: DB_SSL=true and optionally DB_SSL_CA_FILE=/path/to/provider-ca.pem
DB_SSL=false
# DB_SSL_CA_FILE=

PORT=3000
HOST=127.0.0.1
# On Render, HOST=0.0.0.0; set PUBLIC_ORIGIN=https://<your-service>.onrender.com
# PUBLIC_ORIGIN=
# DEMO_AUTO_INIT=true    # Creates tables on server start, only in demo DB
# DEMO_AUTO_SEED=true    # Seeds sample catalog if DB is empty

# Only for optional seed of fictional accounts (replace these with your own strong values).
# DEMO_SEED_USERS=true
# DEMO_USER_PASSWORD=<strong-demo-only-password>
